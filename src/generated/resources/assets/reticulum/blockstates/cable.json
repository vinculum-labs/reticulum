      }
    },
    {
      "apply": {
        "model": "reticulum:block/cable_arm"
      },
      "when": {
        "north": "cable"
      }
    },
    {
      "apply": {
        "model": "reticulum:block/cable_arm",
        "y": 180
      },
      "when": {
        "south": "cable"
      }
    },
    {
      "apply": {
        "model": "reticulum:block/cable_arm",
        "x": 90
      },
      "when": {
        "down": "cable"
      }
    },
    {
      "apply": {
        "model": "reticulum:block/cable_arm",
